// ============================================================
//  WiFi 접속 정보 — 이 파일을 wifi_secrets.h로 복사해 실제 값 기입
//  (wifi_secrets.h는 .gitignore 처리 — 저장소에 올라가지 않음)
// ============================================================
#pragma once

#define WIFI_SSID "YOUR_WIFI_NAME"
#define WIFI_PASS "YOUR_WIFI_PASSWORD"

// 무선 전송 사용 여부: 1이면 WiFi TCP 서버(포트 9000) + mDNS(doa-node.local) 가동.
// 노트북 serve.py는 --net doa-node.local 로 접속. USB 시리얼은 폴백으로 항상 동작.
#define ENABLE_WIFI 1
